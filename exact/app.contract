// ExactReview: a mobile-first GitHub PR review client, ported to Exact.
// Core flows of the Rust/macOS app in the repository root: a queue of pull
// requests, a diff view with honest big-diff handling (virtualized rows,
// large and generated files start collapsed, oversized files load per file
// and truncate with a notice), single-key navigation, and review/comment.
//
// Data is app.ts's: deterministic fixtures byte-identical to the Rust app's
// benchmark harness, or live GitHub when a token is saved in Settings.
//
// Touch does the whole loop — browse the queue, open a pull, read the diff,
// go back — with 44px hit targets and nothing pinned above the scrolling
// diff: the body, the stats and the collapse controls are the list's leading
// content and scroll away with it. The keyboard flows (j/k, gg/G, /, n/p/x,
// c/a/q/r) are unchanged. Diff content ships as multi-line chunk rows rather
// than one row per line, so the virtualized list measures a handful of rows
// per viewport instead of dozens (see BENCH.md).

routes nav
  home "/"
    pr "/pr/:id"

shape Time
  epochAtZero: number

shape PullRow
  id: string
  number: number
  title: string
  repo: string
  author: string
  additions: number
  deletions: number
  changedFiles: number
  checkState: string
  review: string
  draft: bool
  updatedLabel: string

shape PullList
  pulls: PullRow[]
  mode: string
  note: string

shape PrDetail
  id: string
  number: number
  title: string
  repo: string
  url: string
  author: string
  branch: string
  bodyMarkdown: string
  additions: number
  deletions: number
  changedFiles: number
  review: string

// One rendered line inside a chunk row. Hunk/meta lines render full-width;
// context/add/del render with line-number gutters and a marker column.
shape DiffLine
  id: string
  kind: string
  text: string
  oldNo: number
  newNo: number

// A row of the flattened diff list: a file header, a notice, or a chunk of
// lines. Chunking keeps the mounted row count small no matter how many lines
// are in view.
shape DiffRow
  id: string
  fileIndex: number
  kind: string
  text: string
  aux: string
  oldNo: number
  newNo: number
  lines: DiffLine[]

shape DiffFile
  id: string
  index: number
  name: string
  stat: string
  rowCount: number
  lineCount: number
  startCollapsed: bool
  lazy: bool
  truncated: bool
  generated: bool
  rows: DiffRow[]

shape DiffData
  pullId: string
  fileCount: number
  totalLines: number
  droppedFiles: number
  files: DiffFile[]

shape LazyFileRows
  fileIndex: number
  rows: DiffRow[]

shape LazyAnswer
  pullId: string
  files: LazyFileRows[]

shape Reply
  ok: bool
  error: string
  url: string

shape Settings
  mode: string
  hasToken: bool

// A file is collapsed when its start state differs from the user's flips;
// flips from another pull (a stale key) do not count.
fn isCollapsed(f: DiffFile, toggled: string[], key: string, pullId: string): bool =
  key == pullId ? f.startCollapsed != toggled.includes(`${f.index}`) : f.startCollapsed

// The rows one file contributes to the flattened diff list. The header row is
// rows[0] always; a collapsed file contributes it alone. A lazy file shows its
// notice row until the per-file load answers, then its real rows.
fn rowsOf(f: DiffFile, lazy: LazyAnswer, collapsed: bool): DiffRow[] = (collapsed ? f.rows.slice(0, 1) :
    f.lazy ? match first(lazy.files.filter(x => x.fileIndex == f.index)) { case some(x) => f.rows.slice(0, 1).concat(x.rows), case none => f.rows } :
      f.rows)

fn plural(n: number, one: string, many: string): string =
  n == 1 ? `1 ${one}` : `${n} ${many}`

component App
  resource time = exactTime() as shape Time
  state query = ""
  state typing = false
  state selIndex = 0
  state settingsOpen = false
  state draftToken = ""
  state note = ""
  // Files whose collapse state the user flipped on the open pull. `toggledKey`
  // is that pull's id; a different pull reads as no flips.
  state toggledKey = ""
  state toggled: string[] = []
  // The file cursor on the detail screen: which file n/p move and x collapses.
  state fileCursor = 0
  state commenting = false
  state descOpen = false
  state draftComment = ""
  state ggAt = 0
  resource settings = loadSettings() as shape Settings else empty()
  resource pulls = loadPulls() as shape PullList else empty()
  resource detail = loadDetail(selectedId) when selectedId != "" as shape PrDetail else empty()
  resource diff = loadDiff(selectedId) when selectedId != "" as shape DiffData else empty()
  resource lazyRows = loadLazyRows(selectedId, lazyKey) when lazyKey != "" as shape LazyAnswer else empty()
  mutation settingsSaved as shape Reply refreshes settings, pulls then afterSettings
  mutation commented as shape Reply refreshes detail then afterComment
  mutation approved as shape Reply refreshes detail then afterApprove
  derive route = top(nav).name
  derive selectedId = match stack(nav).filter(e => e.name == "pr").at(-1) { case some(e) => e.params.id, case none => "" }
  derive shown = pulls.pulls.filter(p => query.trim() == "" or p.title.toLowerCase().includes(query.trim().toLowerCase()) or p.repo.toLowerCase().includes(query.trim().toLowerCase()) or p.number.toString() == query.trim())
  derive selId = match shown.at(selIndex) { case some(p) => p.id, case none => "" }
  derive rows = diff.files.map(f => rowsOf(f, lazyRows, isCollapsed(f, toggled, toggledKey, selectedId))).flat()
  derive lazyKey = diff.pullId == selectedId ? diff.files.filter(f => f.lazy and not isCollapsed(f, toggled, toggledKey, selectedId)).map(f => `${f.index}`).join(",") : ""

  action back
    nav = back(nav)
    descOpen = false
  action follow(url: string)
    nav = top(nav).name == "pr" and url.startsWith("/pr/") ? replace(nav, url) : go(nav, url)
  action search(v: string)
    query = v
    selIndex = 0
  action focusFilter
    focus("filter")
  action typeStarted
    typing = true
  action typeEnded
    typing = false
  action clearNote
    note = ""
  action noop
    note = note
  action reloadQueue
    refresh pulls
    if selectedId != ""
      refresh detail
      refresh diff

  // Movement in the queue. The selection index is into the filtered list and
  // clamps at both ends.
  action moveSel(delta: number)
    if shown.length > 0
      let next = max(0, min(shown.length - 1, selIndex + delta))
      selIndex = next
      let row = shown.at(next)
      match row
        case some(p)
          scrollIntoView("pr-list", p.id, block="nearest")
        case none
          selIndex = 0
  action jumpSel(last: bool)
    if shown.length > 0
      let next = last ? shown.length - 1 : 0
      selIndex = next
      let row = shown.at(next)
      match row
        case some(p)
          scrollIntoView("pr-list", p.id, block="nearest")
        case none
          selIndex = 0
  action openSelected
    let row = shown.at(selIndex)
    match row
      case some(p)
        nav = push(nav, path("pr", p.id))
      case none
        note = note

  // j/k on the detail screen walk the unfiltered queue, as the Rust app does.
  action openDelta(delta: number)
    let at = pulls.pulls.map(p => p.id).indexOf(selectedId)
    if at >= 0
      let row = pulls.pulls.at(at + delta)
      match row
        case some(p)
          nav = replace(nav, path("pr", p.id))
          toggledKey = ""
          fileCursor = 0
        case none
          note = note

  action toggleFile(index: number)
    let key = `${index}`
    if toggledKey != selectedId
      toggledKey = selectedId
      toggled = [key]
    else
      toggled = toggled.includes(key) ? toggled.filter(x => x != key) : toggled.concat([key])
  action fileRowTapped(index: number, kind: string)
    if kind == "file"
      toggleFile(index)
  action toggleDesc
    descOpen = not descOpen
  action moveFileCursor(delta: number)
    if diff.fileCount > 0
      let next = max(0, min(diff.fileCount - 1, fileCursor + delta))
      fileCursor = next
      scrollIntoView("diff-list", `f${next}`, block="nearest")
  action collapseAll(collapse: bool)
    toggledKey = selectedId
    toggled = diff.files.filter(f => f.startCollapsed != collapse).map(f => `${f.index}`)

  // Review.
  action openComment
    commenting = true
    draftComment = ""
    showModal("comment")
  action editComment(v: string)
    draftComment = v
  action closeComment
    commenting = false
    close("comment")
  action commentKey(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.shiftKey
      preventDefault()
      sendComment()
  action sendComment
    if draftComment.trim() != "" and not pending(commented)
      send commented = postComment(selectedId, draftComment.trim())
  action afterComment
    match commented
      case some(r)
        if r.ok
          commenting = false
          close("comment")
          note = "Comment posted"
          draftComment = ""
        else
          note = r.error
      case none
        note = note
  action approve
    if not pending(approved)
      send approved = postApproval(selectedId)
  action afterApprove
    match approved
      case some(r)
        note = r.ok ? "Approved" : r.error
      case none
        note = note

  // Settings.
  action openSettings
    settingsOpen = true
    draftToken = ""
    showModal("settings")
  action closeSettings
    settingsOpen = false
    close("settings")
  action editToken(v: string)
    draftToken = v
  action pickMode(mode: string)
    send settingsSaved = saveSettings(mode, "")
  action saveToken
    send settingsSaved = saveSettings(settings.mode, draftToken.trim())
  action forgetToken
    send settingsSaved = saveSettings(settings.mode, "forget")
  action afterSettings
    match settingsSaved
      case some(r)
        note = r.ok ? "Settings saved" : r.error
      case none
        note = note

  // The keyboard. Keys bubble here at the root; a field being edited swallows
  // everything but Escape. Modifier chords are left to the host.
  action keyPressed(k: string, e: KeyboardEvent)
    if typing
      if k == "Escape"
        typing = false
        blur()
    else if e.metaKey or e.ctrlKey or e.altKey
      ggAt = 0
    else if route == "pr"
      if k == "j"
        openDelta(1)
      else if k == "k"
        openDelta(-1)
      else if k == "n"
        moveFileCursor(1)
      else if k == "p"
        moveFileCursor(-1)
      else if k == "x"
        let f = diff.files.at(fileCursor)
        match f
          case some(file)
            toggleFile(file.index)
          case none
            note = note
      else if k == "c"
        openComment()
      else if k == "a"
        approve()
      else if k == "q" or k == "Escape"
        nav = back(nav)
      else if k == "r"
        reloadQueue()
    else
      if k == "g"
        if performanceNow() - ggAt < 900 and ggAt > 0
          jumpSel(false)
          ggAt = 0
        else
          ggAt = performanceNow()
      else if k == "G"
        jumpSel(true)
        ggAt = 0
      else if k == "j"
        moveSel(1)
        ggAt = 0
      else if k == "k"
        moveSel(-1)
        ggAt = 0
      else if k == "Enter"
        openSelected()
        ggAt = 0
      else if k == "/"
        preventDefault()
        focusFilter()
        ggAt = 0
      else if k == "Escape"
        query = ""
        selIndex = 0
        ggAt = 0
      else if k == "r"
        reloadQueue()
        ggAt = 0
      else
        ggAt = 0

  task toastTimer when note != ""
    after(2600, clearNote)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow key=keyPressed testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="pr-list" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" flex-direction="column" gap=8 padding="8px 16px"
              row align-items="center" gap=8
                text "Review requested" role="heading" aria-level=1 flex=1 testId="home-title"
                button press=openSettings aria-label="Settings" testId="open-settings" padding=12
                  image "symbol:settings"
              input id="filter" type="search" value=query input=search focus=typeStarted blur=typeEnded placeholder="Filter  ( / )" aria-label="Filter pull requests" testId="filter" width="100%" min-height=44
            if pulls.note != ""
              text pulls.note font="-exact-footnote" padding="4px 16px" testId="mode-note"
            if failed(pulls)
              column flex=1 align-items="center" justify-content="center" gap=12 padding=24
                text "The queue couldn't be loaded." testId="load-error"
                button press=reloadQueue buttonStyle="bordered" testId="retry"
                  text "Try Again"
            else
              list id="pr-list" appearance="none" virtualized=true estimated-item-height=57 flex=1 min-height=0 testId="list"
                row padding="2px 16px 6px" align-items="baseline" gap=8
                  text `${shown.length} of ${pulls.pulls.length}` role="status" font="-exact-caption1" color="-exact-secondary-label" testId="counts"
                  if pulls.mode == "fixture"
                    text "offline fixture" font="-exact-caption1" color="-exact-secondary-label"
                for p in shown key=p.id
                  link href=path("pr", p.id) aria-selected=(selId == p.id) testId=`row-${p.number}`
                    row align-items="center" gap=10 padding="10px 16px" background-color=(selId == p.id ? "light-dark(#3a5a8c12, #3a5a8c40)" : "#00000000")
                      column flex=1 min-width=0 gap=1
                        row align-items="baseline" gap=8 flex-wrap="wrap"
                          text `#${p.number}` font="-exact-caption1" line-height="1.25rem" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          text p.title line-height="1.25rem" flex=1 min-width=0 testId=`title-${p.number}`
                        row align-items="center" gap=8 flex-wrap="wrap"
                          text `${p.repo} · ${p.author}` font="-exact-caption1" line-height="1rem" color="-exact-secondary-label"
                          text `+${p.additions}` font="-exact-caption1" line-height="1rem" color="light-dark(#166f2f, #3fb950)" font-variant-numeric="tabular-nums"
                          text `−${p.deletions}` font="-exact-caption1" line-height="1rem" color="light-dark(#b91c1c, #f85149)" font-variant-numeric="tabular-nums"
                          text p.updatedLabel font="-exact-caption1" line-height="1rem" color="-exact-secondary-label"
                      row align-items="center" gap=6
                        if p.draft
                          text "Draft" font="-exact-caption1" color="-exact-secondary-label"
                        if p.review == "APPROVED"
                          text "✓" color="light-dark(#166f2f, #3fb950)" font-size="0.8rem"
                        else if p.review == "CHANGES_REQUESTED"
                          text "✗" color="light-dark(#b91c1c, #f85149)" font-size="0.8rem"
                        if p.checkState == "SUCCESS"
                          text "●" color="light-dark(#166f2f, #3fb950)" font-size="0.625rem"
                        else if p.checkState == "FAILURE" or p.checkState == "ERROR"
                          text "●" color="light-dark(#b91c1c, #f85149)" font-size="0.625rem"
                        else if p.checkState == "PENDING" or p.checkState == "EXPECTED"
                          text "●" color="light-dark(#8a5a00, #d4a72c)" font-size="0.625rem"
        if e.name == "pr"
          column navigationKey=`${e.id}` navigationScroll="diff-list" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" gap=8 padding="6px 8px"
              button id="back" press=back aria-label="Back" testId="detail-back" padding=12
                image "symbol:back"
              column flex=1 min-width=0
                text detail.title role="heading" aria-level=2 line-clamp=1 testId="detail-title"
                text `${detail.repo} #${detail.number} · ${detail.author}` font="-exact-caption1" color="-exact-secondary-label" line-clamp=1
              button press=approve testId="approve" min-height=44 padding="8px 14px"
                text "Approve"
              button press=openComment testId="open-comment" min-height=44 padding="8px 14px"
                text "Comment"
            column flex=1 min-height=0
              list id="diff-list" appearance="none" virtualized=true estimated-item-height=1152 flex=1 min-height=0 testId="diff"
                column gap=12 padding="10px 16px 16px"
                  if failed(detail)
                    text "Couldn't load this pull request." color="light-dark(#b91c1c, #f85149)"
                  if detail.bodyMarkdown == "" and not failed(detail)
                    text "Loading…" color="-exact-secondary-label" testId="desc-loading"
                  row press=toggleDesc align-items="center" gap=8 min-height=44 testId="desc-toggle" role="button" aria-expanded=descOpen
                    text (descOpen ? "⌄" : "›") width="1rem" color="-exact-secondary-label"
                    text "Description" font-weight=600
                  if descOpen and detail.bodyMarkdown != ""
                    text detail.bodyMarkdown markup="markdown" testId="desc-body"
                  row align-items="center" gap=10 flex-wrap="wrap"
                    text plural(diff.fileCount, "file", "files") font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="diff-stat-files"
                    text plural(diff.totalLines, "line", "lines") font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="diff-stat-lines"
                    if diff.droppedFiles > 0
                      text plural(diff.droppedFiles, "file", "files") font="-exact-caption1" color="light-dark(#b91c1c, #f85149)" testId="diff-dropped"
                    row flex=1
                    button press=collapseAll(true) testId="collapse-all" min-height=44 padding="8px 14px"
                      text "Collapse all"
                    button press=collapseAll(false) testId="expand-all" min-height=44 padding="8px 14px"
                      text "Expand all"
                  if diff.fileCount == 0 and not failed(diff)
                    text "Loading diff…" color="-exact-secondary-label" testId="diff-loading"
                for r in rows key=r.id
                  column gap=0
                    if r.kind == "file"
                      row press=fileRowTapped(r.fileIndex, r.kind) align-items="center" gap=8 padding="8px 16px" min-height=44 background-color="light-dark(#8a8f9818, #8a8f9824)" testId=`diffrow-${r.id}`
                        text (match diff.files.at(r.fileIndex) { case some(f) => isCollapsed(f, toggled, toggledKey, selectedId), case none => false } ? "›" : "⌄") width="1rem" color="-exact-secondary-label"
                        text r.text font-family="ui-monospace" font-size="0.75rem" line-clamp=1 flex=1 min-width=0 testId=`fname-${r.fileIndex}`
                        text r.aux font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                    else if r.kind == "notice"
                      row padding="8px 16px" testId=`diffrow-${r.id}`
                        text r.text font-family="ui-monospace" font-size="0.75rem" line-clamp=2 color="light-dark(#0550ae, #58a6ff)"
                    else
                      column gap=0 testId=`diffrow-${r.id}`
                        for line in r.lines key=line.id
                          row align-items="center" background-color=(line.kind == "add" ? "light-dark(#2da44e1c, #2da44e26)" : line.kind == "del" ? "light-dark(#cf222e1a, #f851491f)" : line.kind == "hunk" ? "light-dark(#0969da14, #58a6ff1f)" : "#00000000")
                            if line.kind == "hunk" or line.kind == "meta"
                              text line.text font-family="ui-monospace" font-size="0.75rem" line-height="1rem" line-clamp=1 flex=1 padding="1px 12px" white-space="nowrap" color=(line.kind == "hunk" ? "light-dark(#0550ae, #58a6ff)" : "-exact-secondary-label")
                            else
                              text (line.oldNo == 0 ? "" : `${line.oldNo}`) width="2.2rem" text-align="right" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="-exact-secondary-label" font-variant-numeric="tabular-nums" padding="1px 2px"
                              text (line.newNo == 0 ? "" : `${line.newNo}`) width="2.2rem" text-align="right" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="-exact-secondary-label" font-variant-numeric="tabular-nums" padding="1px 2px"
                              text (line.kind == "add" ? "+" : line.kind == "del" ? "−" : " ") width="0.7rem" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=(line.kind == "add" ? "light-dark(#166f2f, #3fb950)" : line.kind == "del" ? "light-dark(#b91c1c, #f85149)" : "-exact-secondary-label") padding="1px 0"
                              text (line.text == "" ? " " : line.text) font-family="ui-monospace" font-size="0.75rem" line-height="1rem" line-clamp=1 flex=1 padding="1px 4px 1px 0" white-space="nowrap" color=(line.kind == "add" ? "light-dark(#166f2f, #3fb950)" : line.kind == "del" ? "light-dark(#b91c1c, #f85149)" : "-exact-label")
      dialog id="comment" aria-label="Comment on this pull request"
        column gap=10 padding=16
          text "Comment" role="heading" aria-level=2
          textarea value=draftComment input=editComment focus=typeStarted blur=typeEnded key=commentKey rows=6 placeholder="Leave a comment — Enter posts, Shift+Enter a new line" aria-label="Comment" testId="comment-body" width="70vw"
          if pending(commented)
            text "Posting…" font="-exact-footnote" color="-exact-secondary-label" testId="comment-pending"
          if match commented { case some(r) => not r.ok, case none => false }
            text (match commented { case some(r) => r.error, case none => "" }) font="-exact-footnote" color="-exact-system-red" testId="comment-error"
          row gap=10 justify-content="flex-end"
            button press=closeComment testId="comment-cancel" min-height=44 padding="8px 14px"
              text "Cancel"
            button press=sendComment buttonStyle="bordered-prominent" disabled=(draftComment.trim() == "" or pending(commented)) testId="comment-send" min-height=44 padding="8px 14px"
              text "Comment"
      dialog id="settings" aria-label="Settings"
        column gap=12 padding=16
          text "Settings" role="heading" aria-level=2
          text `Data: ${settings.mode == "live" ? "live GitHub" : "bundled fixtures"}${settings.hasToken ? "" : " — no token saved"}` font="-exact-footnote" color="-exact-secondary-label" testId="settings-mode"
          row gap=8 flex-wrap="wrap"
            button press=pickMode("fixture") buttonStyle=(settings.mode == "live" ? "bordered" : "bordered-prominent") testId="mode-fixture" min-height=44 padding="8px 14px"
              text "Fixtures"
            button press=pickMode("live") buttonStyle=(settings.mode == "live" ? "bordered-prominent" : "bordered") testId="mode-live" min-height=44 padding="8px 14px"
              text "Live GitHub"
          textarea value=draftToken input=editToken focus=typeStarted blur=typeEnded rows=2 placeholder="GitHub token (stored only on this device)" aria-label="GitHub token" testId="token-field" width="70vw"
          row gap=10 justify-content="flex-end"
            button press=closeSettings testId="settings-close" min-height=44 padding="8px 14px"
              text "Done"
            if settings.hasToken
              button press=forgetToken destructive=true testId="token-forget" min-height=44 padding="8px 14px"
                text "Forget Token"
            button press=saveToken buttonStyle="bordered" disabled=(draftToken.trim() == "") testId="token-save" min-height=44 padding="8px 14px"
              text "Save Token"
      if note != ""
        row press=clearNote position="absolute" bottom=18 align-self="center" padding="8px 16px" background-color="light-dark(#24292f, #f6f8fa)" border-radius=8 testId="toast"
          text note color="light-dark(#ffffff, #24292f)" font-size="0.8rem"
